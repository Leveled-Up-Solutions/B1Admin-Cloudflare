{
  "name": "b1-cloudflare-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file=seed.sql",
    "build": "wrangler deploy --dry-run --outdir=dist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "miniflare": "5.20261103.0-beta",
    "typescript": "^6.0.3",
    "wrangler": "4.157.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "rrule": "2.8.1"
  }
}
